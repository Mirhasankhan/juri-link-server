# ==============================================
# Server Configuration
# ==============================================
NODE_ENV=development
PORT=5000

# ==============================================
# Database & Cache
# ==============================================
# Local: mongodb://127.0.0.1:27017/juri-link
# Docker Compose: mongodb://mongo:27017/juri-link
DATABASE_URL=mongodb://mongo:27017/juri-link

# Local: redis://127.0.0.1:6379
# Docker Compose: redis://redis:6379
REDIS_URL=redis://redis:6379

# ==============================================
# Authentication & Security
# ==============================================
BCRYPT_SALT_ROUND=10
JWT_SECRET=your_jwt_secret_key
JWT_FORGET_KEY=your_jwt_forget_key
GEN_SALT=10
EXPIRES_IN=15d

# ==============================================
# URLs & Routing
# ==============================================
CLIENT_URL=http://localhost:3000
DASHBOARD_URL=https://juri-link-dashboard.vercel.app
API_LINK=http://localhost:5000

# ==============================================
# Email (SMTP)
# ==============================================
EMAIL=your_email@gmail.com
APP_PASS=your_gmail_app_password
SMTP_USER_NAME=
SMTP_PASSWORD=

# ==============================================
# Encryption
# ==============================================
ENCRYPTION_KEY=
ENCRYPTION_IV=

# ==============================================
# DigitalOcean Spaces / S3
# ==============================================
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_BUCKET_NAME=smtech-space
DO_ACCESS_KEY=
DO_SECRET_KEY=
DO_CDN_ENDPOINT=

# ==============================================
# Cloudinary
# ==============================================
CLOUD_NAME=
API_KEY=
API_SECRET=

# ==============================================
# Stripe
# ==============================================
STRIPE_SK=
STRIPE_PK=
STRIPE_WEBHOOK_SECRET=

# ==============================================
# Zoom
# ==============================================
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ==============================================
# Super Admin Initial Credentials
# ==============================================
SUPER_ADMIN_NAME=Mir Hasan
SUPER_ADMIN_EMAIL=admin@gmail.com
SUPER_ADMIN_PASSWORD=123456
